{
  "name": "farmlingo-backend",
  "version": "0.1.0",
  "description": "Modular Node.js backend for Farmlingo (health endpoint + basic setup)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run db:push && npm run build && node dist/server.js",
    "dev": "npm run build && nodemon --watch src --watch server.ts --watch dist --ext ts,js --exec node dist/server.js",
    "lint": "eslint src/**/*.ts utils/**/*.ts *.ts || true",
    "db:push": "npx drizzle-kit up:pg",
    "db:studio": "npx drizzle-kit studio"
  },
  "author": "hannah Authur",
  "license": "MIT",
  "dependencies": {
    "@clerk/clerk-sdk-node": "^5.1.6",
    "@neondatabase/serverless": "^1.0.2",
    "@types/socket.io": "^3.0.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "detect-port": "^2.1.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.7",
    "express": "^4.21.2",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "svix": "^1.82.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^4.6.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/swagger-jsdoc": "^3.0.2",
    "@types/swagger-ui-express": "^4.1.3",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "baseline-browser-mapping": "^2.9.15",
    "drizzle-kit": "^0.18.1",
    "eslint": "^8.57.1",
    "nodemon": "^3.1.11",
    "ts-node": "^1.7.1",
    "typescript": "^5.9.3"
  }
}
